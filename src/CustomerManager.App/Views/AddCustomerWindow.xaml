<Window x:Class="CustomerManager.App.Views.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AddCustomerWindow"
        Title="Add customer"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=FullNameTextBox}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <StackPanel Margin="24">
        <Label Content="_Full name *" Target="{Binding ElementName=FullNameTextBox}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FullNameTextBox"
                 AutomationProperties.AutomationId="FullNameTextBox"
                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock AutomationProperties.AutomationId="FullNameError" Text="{Binding FullNameError}" Style="{StaticResource ErrorText}" />

        <Label Content="_Email *" Target="{Binding ElementName=EmailTextBox}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="EmailTextBox"
                 AutomationProperties.AutomationId="EmailTextBox"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock AutomationProperties.AutomationId="EmailError" Text="{Binding EmailError}" Style="{StaticResource ErrorText}" />

        <Label Content="_Phone" Target="{Binding ElementName=PhoneTextBox}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="PhoneTextBox"
                 AutomationProperties.AutomationId="PhoneTextBox"
                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock AutomationProperties.AutomationId="PhoneError" Text="{Binding PhoneError}" Style="{StaticResource ErrorText}" />

        <Label Content="Customer _type" Target="{Binding ElementName=CustomerTypeComboBox}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="CustomerTypeComboBox"
                  AutomationProperties.AutomationId="CustomerTypeComboBox"
                  ItemsSource="{Binding CustomerTypes}"
                  SelectedItem="{Binding SelectedType}" />

        <Label Content="Customer _since *" Target="{Binding ElementName=CustomerSinceDatePicker}" Style="{StaticResource FieldLabel}" />
        <DatePicker x:Name="CustomerSinceDatePicker"
                    AutomationProperties.AutomationId="CustomerSinceDatePicker"
                    SelectedDate="{Binding CustomerSince}" />
        <TextBlock AutomationProperties.AutomationId="CustomerSinceError" Text="{Binding CustomerSinceError}" Style="{StaticResource ErrorText}" />

        <!-- Intentionally no AutomationId (Episode 6): found only by its Name, which comes from the Content text. -->
        <CheckBox Content="Subscribe to newsletter"
                  IsChecked="{Binding SubscribeToNewsletter}"
                  Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button AutomationProperties.AutomationId="SaveButton"
                    Content="Save"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,8,0" />
            <!-- Intentionally no AutomationId (Episode 6). -->
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
