<Window x:Class="CustomerManager.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="LoginWindow"
        Title="Customer Manager - Sign in"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">
    <StackPanel Margin="24">
        <TextBlock Text="Customer Manager" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Sign in to continue" Foreground="Gray" Margin="0,0,0,12" />

        <Label Content="_Username" Target="{Binding ElementName=UsernameTextBox}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameTextBox"
                 AutomationProperties.AutomationId="UsernameTextBox"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="_Password" Target="{Binding ElementName=PasswordInput}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput"
                     AutomationProperties.AutomationId="PasswordBox"
                     PasswordChanged="OnPasswordChanged" />

        <TextBlock AutomationProperties.AutomationId="LoginErrorText"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   Margin="0,10,0,0" />

        <Button AutomationProperties.AutomationId="SignInButton"
                Content="Sign in"
                IsDefault="True"
                Command="{Binding SignInCommand}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0" />
    </StackPanel>
</Window>
